__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Generated artifacts: the database is rebuilt deterministically from
# synthetic_data.py, so it is an output, not a source of truth.
*.db
*.sqlite
*.sqlite3
data/

# PyCharm project files are machine-specific (interpreter paths, local run
# configs), so they stay untracked. .vscode/ is tracked on purpose: its
# launch configs encode the one thing that is easy to get wrong here --
# running the CLI as a module from the repo root, not as a script.
.idea/
